# Source before running aider against local Ollama (OpenAI-compatible API).
# Copy to e.g. ~/z/env/ai/aider/ollama.env and adjust OLLAMA_HOST if needed.
#
#   set -a; . ~/z/env/ai/aider/ollama.env; set +a
#   aider --model ollama/qwen2.5-coder:7b
#
# Model names must match `ollama list` tags (prefix with ollama/).

export OLLAMA_HOST="${OLLAMA_HOST:-127.0.0.1:11434}"
# OpenAI-compatible surface (chat completions)
export OPENAI_API_BASE="http://${OLLAMA_HOST}/v1"
export OPENAI_API_KEY="ollama"
# Native Ollama HTTP API (no /v1 — aider/litellm call /api/show etc. under this host)
export OLLAMA_API_BASE="http://${OLLAMA_HOST}"

# Optional: reduce provider-specific quirks
# export AIDER_AUTO_TEST=false
