# Copy to ~/z/env/ai/hermes/ollama-override.env (600 perms).
# Loaded last by restore/scripts/launch-hermes-agent-tmux.sh so it overrides api-keys.env.
#
# Hermes treats Ollama as an OpenAI-compatible server (/v1/chat/completions).
# Replace 192.168.8.106 with your Ollama host (Supermicro or host.docker.internal if Ollama runs on the Docker host).

OPENAI_BASE_URL=http://192.168.8.106:11434/v1
OPENAI_API_KEY=ollama

# Optional: default chat model (Ollama tag must exist on the server).
# Prefer persisting via `hermes model` → custom endpoint; this env is a convenience.
# HERMES_MODEL=gemma4:26b-a4b-it-q4_K_M
