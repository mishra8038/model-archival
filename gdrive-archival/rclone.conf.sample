# Copy to rclone.conf and fill in your OAuth token (rclone config).
# Remote name must be "gdrive".
#
# Staging workflow (default config.yaml): uploads go to folder
#   https://drive.google.com/drive/folders/1JFis3GXDbVxvRO_m4pJnBuO5LpYCf4sJ
# Use the SAME folder ID here as in config.yaml gdrive.remote — never mix two IDs.

[gdrive]
type = drive
scope = drive
token = {"access_token":"...","token_type":"Bearer",...}
# Optional: root_folder_id = 1JFis3GXDbVxvRO_m4pJnBuO5LpYCf4sJ
# If set, use gdrive.remote: "gdrive:" with no second folder ID, or omit root_folder_id and put the full ID only in config.yaml.
